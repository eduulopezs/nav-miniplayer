    "dur-in": ".32s",
    "dur-out": ".18s",
    "font-sans": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif"
  },
  "themes": {
    "glass": {
      "text": "{white}",
      "bg-a": "{slate-600}",
      "bg-b": "{slate-800}",
