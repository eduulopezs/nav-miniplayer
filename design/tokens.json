  "shared": {
    "ease-out": "cubic-bezier(.22, 1, .36, 1)",
    "ease-in": "ease-in",
    "ease-pulse": "ease-in-out",
    "dur-in": ".32s",
    "dur-out": ".18s",
    "dur-fast": ".15s",
    "dur-pulse": "1s",
    "dur-nudge": ".28s",
    "dur-swap": ".45s",
    "font-sans": "\"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
    "font-ui": "system-ui, sans-serif",
    "space-1": "2px",
    "space-2": "4px",
    "space-3": "6px",
    "space-4": "8px",
    "space-5": "10px",
    "space-6": "16px",
    "size-ring": "2px",
    "size-vol": "88px",
    "size-target": "24px",
    "blur-cover": "14px",
    "size-ring-offset": "3px",
