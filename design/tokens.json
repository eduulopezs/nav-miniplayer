    "opacity-pulse": ".55",
    "focus": "{white}",
    "on-overlay": "{white}",
    "scrim-toast": "{black}@.72",
    "opacity-disabled": ".35",
    "press-scale": ".93",
    "press-shift": "1px",
    "icon-turn": "-60deg",
    "icon-shrink": ".4",
    "nudge-shift": "4px"
  },
  "themes": {
    "glass": {
      "bg-b": "{slate-800}"
