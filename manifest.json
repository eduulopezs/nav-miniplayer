{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "es",
  "version": "1.14.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "scripting", "tabCapture", "offscreen", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "action": { "default_title": "__MSG_actionTitle__" },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "__MSG_cmdToggle__" },
    "play-pause": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "__MSG_cmdPlay__" },
    "seek-back": { "suggested_key": { "default": "Alt+Shift+Comma" }, "description": "__MSG_cmdBack__" },
    "seek-fwd": { "suggested_key": { "default": "Alt+Shift+Period" }, "description": "__MSG_cmdFwd__" },
    "prev-track": { "description": "__MSG_cmdPrev__" },
    "next-track": { "description": "__MSG_cmdNext__" },
    "open-window": { "description": "__MSG_cmdWindow__" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/frame-agent.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/page/media-session-bridge.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/config.js",
        "src/content/util.js",
        "src/content/media.js",
        "src/content/storyboard.js",
        "src/content/tokens.js",
        "src/content/fonts.js",
        "src/content/viz.js",
        "src/content/skins/noir.js",
        "src/content/skins/crt.js",
        "src/content/skins/glass.js",
        "src/content/skins/metal.js",
        "src/content/styles.js",
        "src/content/menu.js",
        "src/content/player.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
