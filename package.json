{
  "name": "nav-miniplayer",
  "private": true,
  "description": "Extensión MV3 (Chrome/Edge): minirreproductor flotante para el audio/vídeo de la pestaña.",
  "license": "MIT",
  "author": "eduulopezs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduulopezs/nav-miniplayer.git"
  },
  "bugs": {
    "url": "https://github.com/eduulopezs/nav-miniplayer/issues"
  },
  "homepage": "https://github.com/eduulopezs/nav-miniplayer#readme",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "mini-player",
    "picture-in-picture",
    "video",
    "audio",
    "edge"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/check.mjs && node scripts/contrast.mjs --strict",
    "smoke": "node scripts/smoke.mjs",
    "security": "node scripts/security.mjs",
    "test": "npm run check && npm run security && npm run smoke",
    "e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "zip": "node scripts/zip.mjs"
  },
  "devDependencies": {
    "playwright": "^1.59.0"
  },
  "engines": {
    "node": ">=22"
  }
}
